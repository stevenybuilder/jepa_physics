  "visualisation": {
   "old_p2_ring_figure_misrepresents": true,
   "cause": "it plots the INTERPOLATING spline (run_geometry_checks fit_curve default) on all 1,200 train clips in label-free angle order with 6 of 63 neighbour swaps and two knots 0.0098 deg apart: the interpolant must pass two separated centroids at almost the same parameter and overshoots to 16.7 PCA units (point 22 recipe: 215) against a ring of radius ~6.7. The steering curve is the smoothing spline on knot folds with the block held out; it stays within 6.3 and never loops. At point 22 the top-2 centroid PC plane is one ring axis plus the cos 2theta fold and draws the fitted ring as a figure 8; the new figures use the ring (cos/sin regression) plane, 68% / 61% of centroid variance at points 12 / 22",
   "new_figures": [
    "figures/fig_ring_fitted_L12.png",
    "figures/fig_ring_fitted_L22.png"
   ]
  },
  "evaluation": {
   "held_out_logic": {
    "pass": true,
    "note": "PCA, centroids and spline use knot folds 0-2 at kept values only; probe/MLP/reference on folds 3-4; steered carriers are test clips whose value != target; nearest-real target means from test clips at the target (never the carrier). Source coordinate is the carrier's true value (oracle), not Goodfire's c_a start"
   },
   "probe_readout": {
    "pass": true,
    "caveat": "a linear (sin, cos) probe reads a chord point between symmetric neighbours at the mid angle: the chord's inward sagitta only lowers the radius, so endpoint probe error cannot reward curvature, only aim; curvature shows only in radius/path metrics"
   },
   "nearest_real_readout": {
    "pass": true,
    "caveat": "ceiling ~0.23 (donor), so gaps of +/-0.01 are small; the readout is still Euclidean-to-centroid at the steered layer"
   },
   "mlp_predictor_readouts": {
    "pass": true,
    "note": "disjoint probe clips / the model's own forward (4.4-4.5); not re-run here"
   },
   "controls": {
    "pass": true,
    "note": "endpoint-matched random (20), shuffled centroids (20), dose-matched line, projected, reflected; control draws use the first 16 clips per target"
   },
   "ci_conventions": {
    "pass": false,
    "issue": "per-run clip bootstrap is sound, but across arcs only mean +/- SD is given: arcs share knots/probe folds, seeds 4 and 8 are the same arc, and one pathological arc (seed 7, +41 deg after the fix on the box) dominates the mean; report median and a sign test / bootstrap over distinct arcs"
   },
   "verdict_margins": {
    "pass": false,
    "issue": "endpoint losses count only beyond the probe's out-of-sample error (~3.9 deg), so a +2.4 deg mean loss against the A.9 raw chord never triggers 'negative_endpoint'; and the verdict compares with the smoothed-knot chord, not the A.9 raw chord. Rule was frozen before the arc sweep (29820ea) but is post hoc"
   }
